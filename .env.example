# Copy to .env and fill real values. Never commit .env.
NODE_ENV=local
API_PORT=3000

# Database (used by Prisma from T002 onwards)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentor_platform?schema=public

# Database used by the repository/integration tests (must be a disposable DB:
# the integration suite resets it before running).
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/mentor_platform_test?schema=public

# Redis (cache / idempotency / locks)
REDIS_URL=redis://localhost:6379

# Session secrets (T003+). Required in production; never commit real values.
ACCESS_TOKEN_SECRET=replace-me-access
REFRESH_TOKEN_SECRET=replace-me-refresh

# Auth (T003+)
# wechat | mock — mock is refused outside isolated dev/test environments.
AUTH_PROVIDER=mock
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ISSUER=mentor-platform
# Keyed hash pepper for WeChat openid/unionid storage. Required in production.
OPENID_HASH_PEPPER=replace-me-openid-pepper

# WeChat mini program
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Feature flags (JSON object)
FEATURE_FLAGS={}

# Verification documents (T006+)
# Private object storage. The mock adapter is refused in production; a real
# private-bucket adapter is required before production use.
OBJECT_STORAGE_BASE_URL=http://127.0.0.1:3000/api/v1/files
# HMAC key for signed upload/download URLs. Required in production.
OBJECT_STORAGE_SIGNING_SECRET=replace-me-object-storage
# 32-byte key (base64 or hex) used to seal document metadata at rest.
# Required in production; a development key is derived when unset outside it.
VERIFICATION_METADATA_KEY=
VERIFICATION_DOCUMENT_MAX_BYTES=10485760
# Short-lived URLs: uploads 15 min, document access 5 min.
VERIFICATION_UPLOAD_URL_TTL=900
VERIFICATION_DOWNLOAD_URL_TTL=300

# Payment (T014+). wechat | mock — the mock adapter is refused in production.
PAYMENT_PROVIDER=mock

# WeChat Pay API v3 (T015+). Secrets: environment or secret manager only.
# Never commit real values, never log them, never store them in the database.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
# Serial number of the merchant API certificate that owns WECHAT_PAY_PRIVATE_KEY.
WECHAT_PAY_SERIAL_NO=
# 32-byte APIv3 key, used to decrypt notification payloads.
WECHAT_PAY_API_V3_KEY=
# Absolute URL WeChat posts notifications to.
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
# The merchant private key: inline PEM, or (preferred) a path to a PEM file.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
# Optional overrides for tests and for the sandbox endpoint.
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_TIMEOUT_MS=5000
