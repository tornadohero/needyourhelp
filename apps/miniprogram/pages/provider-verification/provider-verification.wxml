<view class="page">
  <view class="title">身份与学历验证</view>
  <view class="hint">材料直传对象存储，平台不保存证件文件；审核结果在此查看。</view>

  <view wx:if="{{loading}}" class="state">正在加载…</view>

  <view wx:elif="{{error}}" class="state">
    <text>{{error}}</text>
    <button class="button" size="mini" bindtap="onRetry">重试</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section">提交材料</view>
      <!-- Signed URL upload: no hash, no file in the JSON API. -->
      <button class="button" loading="{{uploading}}" data-type="IDENTITY" bindtap="onUpload">
        上传身份证件
      </button>
      <button class="button" loading="{{uploading}}" data-type="EDUCATION" bindtap="onUpload">
        上传学历证明
      </button>
    </view>

    <view class="card" wx:if="{{cases.length > 0}}">
      <view class="section">我的验证</view>
      <view class="case" wx:for="{{cases}}" wx:key="id">
        <view>{{item.typeText}} · {{item.statusText}}</view>
        <view class="hint">{{item.documentText}} · {{item.submittedText}}</view>
      </view>
    </view>

    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  </block>
</view>
