.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: #8a8a8a;
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #f6f7f9;
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.case {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eceef0;
}

.notice {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #d4380d;
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.button {
  margin-top: 16rpx;
}
