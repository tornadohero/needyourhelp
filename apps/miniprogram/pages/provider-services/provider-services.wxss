.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--muted);
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.service {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.chip-on {
  background: var(--brand);
  color: #ffffff;
}

.input,
.note {
  width: 100%;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.note {
  min-height: 120rpx;
}

.notice {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--notice);
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.button {
  margin-top: 16rpx;
}
