.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--muted);
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.cap,
.ver {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.option {
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.option-on {
  border: 2rpx solid var(--brand);
}

.input,
.note {
  width: 100%;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.note {
  min-height: 120rpx;
}

.notice {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--notice);
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.button {
  margin-top: 24rpx;
}
