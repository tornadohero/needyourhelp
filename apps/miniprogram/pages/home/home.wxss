/* 首页：待办清单，不是导航墙（小清新 · 青芒果绿）。 */

.page {
  padding: 28rpx 24rpx 48rpx;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
}

.sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.roles {
  display: flex;
  gap: 12rpx;
}

.state {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.button {
  margin-top: 24rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  margin: 0 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
}

.card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  box-shadow: 0 6rpx 20rpx rgba(95, 147, 39, 0.06);
}

/* Urgent reads as urgent: a tint, not a siren. */
.card.urgent {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.card.empty {
  color: var(--muted);
  font-size: 26rpx;
  box-shadow: none;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.status {
  font-size: 24rpx;
  color: var(--brand-deep);
}

.when {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text);
}

.hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.actions {
  margin-top: 16rpx;
}

.tag {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 20rpx;
}

.action {
  margin: 0;
}

.today .todo {
  font-size: 24rpx;
  color: var(--brand-deep);
}

/* Four entries, two by two: the rest of the app is one tap away. */
.entries {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.entry {
  flex: 1 1 44%;
  padding: 26rpx 20rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text);
  text-align: center;
}

.dot {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 20rpx;
}

.safety {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

/* Review sheet: five stars and one optional line. */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 40, 25, 0.35);
}

.sheet {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 80rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: 0 20rpx 48rpx rgba(60, 143, 108, 0.18);
}

.stars {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.star {
  font-size: 52rpx;
  color: var(--border);
}

.star-on {
  color: var(--brand);
}

.note {
  width: 100%;
  min-height: 140rpx;
}

.more {
  font-size: 24rpx;
  color: var(--brand-deep);
}

.suggest {
  padding: 16rpx 0 0;
  border-top: 1rpx solid var(--border-soft);
  margin-top: 16rpx;
}

.warn {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  color: var(--notice);
  font-size: 24rpx;
}
