.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--muted);
}

.bio {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.service,
.slot,
.review {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.state {
  font-size: 28rpx;
}

.button {
  margin-top: 24rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.actions .contact {
  flex: 1;
  margin-top: 24rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  border: 1rpx solid var(--border);
}

.actions .button {
  flex: 1;
}
