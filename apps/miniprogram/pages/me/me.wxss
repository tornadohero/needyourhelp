.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 28rpx;
  color: var(--muted);
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.button {
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--border);
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input {
  border: 1rpx solid var(--brand-tint);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.consent {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.notice {
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  font-size: 26rpx;
}
