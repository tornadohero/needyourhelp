.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--muted);
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.section {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.label {
  color: var(--muted);
}

.total {
  font-weight: 600;
}

.refund {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.note {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
}

.notice {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--notice);
}

.state {
  font-size: 28rpx;
}

.button {
  margin-top: 24rpx;
}
