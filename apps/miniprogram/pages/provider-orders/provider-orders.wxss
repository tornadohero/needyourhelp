.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--muted);
}

.card {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.status {
  font-size: 26rpx;
  color: var(--brand);
}

.total {
  font-weight: 600;
}

.notice {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--notice);
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.button {
  margin-top: 16rpx;
}
