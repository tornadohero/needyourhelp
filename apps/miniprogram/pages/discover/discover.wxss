.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 28rpx;
  color: var(--muted);
}

.state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: var(--card);
}

.button {
  margin-top: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chips,
.sorts,
.modes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.chip {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: var(--border-soft);
  font-size: 24rpx;
}

.chip-on {
  background: var(--brand);
  color: #ffffff;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  background: #ffffff;
  border-top: 1rpx solid var(--border);
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0;
}

.input {
  border: 1rpx solid var(--brand-tint);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
