// Mentor Platform — V1 database schema.
//
// Source of truth: `specs/04-database-spec.md`.
//
// Conventions:
// - Table names and column names are taken verbatim from the DB spec (snake_case).
// - Money is always INTEGER minor units (`*_minor`). Never float. (AGENTS.md §8)
// - Timestamps are UTC. (AGENTS.md §5)
// - Identifiers are UUIDs. (AGENTS.md §5)
// - Deferred tables (`settlements`, `settlement_items`, `career_goals`,
//   `mentor_capabilities`) are intentionally NOT part of the V1 schema, per
//   `specs/04-database-spec.md` "Deferred tables (V1.1+ / feature-flagged)".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
//
// Values are taken from the specs where they are enumerated. Where a status
// field exists but the value list is not enumerated, the enum is kept minimal
// and the provenance is documented inline.
// ---------------------------------------------------------------------------

/// `users.status`. Grounded in `specs/01-business-rules.md` ("account active")
/// and `specs/06-verification-state-machine.md` ("ACTIVE -> SUSPENDED -> ACTIVE").
/// Account deletion is represented by `users.deleted_at`, not by a status value.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// `user_roles.role` — `specs/01-business-rules.md` §Account and roles.
enum Role {
  USER
  PARENT
  STUDENT
  PROVIDER
  ADMIN
  OPS
  FINANCE
  MODERATOR
}

/// `provider_profiles.provider_type`.
/// Mirrors the service domain enum in `specs/04-database-spec.md`
/// (`services.domain = TUTORING|CAREER`).
enum ProviderType {
  TUTORING
  CAREER
}

/// `provider_profiles.avatar_visibility`.
/// `specs/07-permission-spec.md`: "avatar: based on visibility".
enum AvatarVisibility {
  PUBLIC
  PRIVATE
}

/// `provider_profiles.service_mode` and `services.delivery_mode`.
/// Values are not enumerated in the specs; kept to the three delivery modes
/// used by the discovery filters in `specs/05-api-spec.md` (`deliveryMode`).
enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

/// `provider_profiles.approval_status` and `provider_capabilities.status`.
/// `specs/06-verification-state-machine.md` §Provider application plus the
/// orthogonal suspension (`ACTIVE -> SUSPENDED -> ACTIVE`). `APPROVED` is the
/// approved/active state; `SUSPENDED` is restored back to `APPROVED`.
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// `provider_capabilities.verification_level`.
/// Derived from the verification types that must be approved before a
/// capability is usable (`specs/01-business-rules.md` §Student tutor).
enum VerificationLevel {
  NONE
  IDENTITY
  EDUCATION
  FULL
}

/// `provider_capabilities.compliance_status`.
/// `specs/06-verification-state-machine.md` §Teacher compliance, plus
/// `SUSPENDED` from `specs/01-business-rules.md` §Teacher provider.
enum ComplianceStatus {
  NOT_REQUIRED
  PENDING
  UNDER_REVIEW
  APPROVED
  RESTRICTED
  REJECTED
  SUSPENDED
}

/// `verification_cases.verification_type`.
/// `specs/01-business-rules.md` (identity + education) and
/// `specs/12-admin-spec.md` (teacher compliance review).
enum VerificationType {
  IDENTITY
  EDUCATION
  TEACHER_COMPLIANCE
}

/// `verification_cases.status` — `specs/06-verification-state-machine.md` §Identity verification.
enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMITTED
}

/// `verification_documents.document_type`.
/// Evidence types implied by `specs/01-business-rules.md` and
/// `specs/12-admin-spec.md`. `OTHER` keeps the intake open for admin review.
enum VerificationDocumentType {
  ID_CARD
  STUDENT_ID
  DIPLOMA
  TEACHER_CERTIFICATE
  EMPLOYMENT_PROOF
  OTHER
}

/// `services.domain` / `conversations.domain` — `specs/04-database-spec.md`.
enum ServiceDomain {
  TUTORING
  CAREER
}

/// `services.status` — `specs/06-verification-state-machine.md` §Service publication.
enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

/// `taxonomy_terms.type` — `specs/04-database-spec.md`.
enum TaxonomyType {
  SUBJECT
  GRADE
  SKILL
  CITY
}

/// `availability_slots.status`.
/// `specs/00-product-spec.md` §V1 scope and `specs/01-business-rules.md`
/// ("valid service availability").
enum AvailabilityStatus {
  OPEN
  BOOKED
  BLOCKED
}

/// `orders.status` — `specs/06-verification-state-machine.md` §Order +
/// terminal states from `specs/01-business-rules.md` §Orders.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REFUND_PENDING
  REFUNDED
  CANCELLED
  DISPUTED
}

/// `payments.provider` — payment adapter port (`specs/03-architecture-spec.md`).
/// `MOCK` is the local/test adapter used before WeChat credentials exist.
enum PaymentProvider {
  WECHAT
  MOCK
}

/// `payments.status`.
/// Lifecycle of `specs/08-payment-and-settlement.md` §Create payment.
enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
}

/// `refunds.status` — `specs/08-payment-and-settlement.md` §Refund.
enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

/// `reviews.status`. `specs/01-business-rules.md` §Review: "Review moderation
/// may hide content but must preserve audit trail."
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// `conversations.status` — `specs/09-im-spec.md`.
enum ConversationStatus {
  OPEN
  BLOCKED
  CLOSED
}

/// `conversation_members.role`.
/// Members are the commercial counterparties of a conversation plus the
/// platform system sender (`specs/09-im-spec.md` §System messages).
enum ConversationMemberRole {
  BUYER
  PROVIDER
  SYSTEM
}

/// `message_refs.message_type` — `specs/09-im-spec.md` §Message policy.
enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

/// `message_refs.moderation_status` — moderation hooks in `specs/09-im-spec.md` §Safety.
enum MessageModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// `reports.target_type` and `moderation_cases.target_type` — `specs/04-database-spec.md`.
enum ModerationTargetType {
  USER
  PROVIDER
  SERVICE
  ORDER
  REVIEW
  MESSAGE
  CONVERSATION
}

/// `reports.reason_code` — `specs/12-admin-spec.md` §Moderation report categories.
enum ReportReasonCode {
  FRAUD
  HARASSMENT
  INAPPROPRIATE_CONTENT
  OFF_PLATFORM_TRANSACTION
  FAKE_CREDENTIALS
  UNSAFE_BEHAVIOR
  PAYMENT_ISSUE
  OTHER
}

/// `reports.status`.
/// Intake lifecycle; the moderation workflow itself lives in `moderation_cases`.
enum ReportStatus {
  PENDING
  UNDER_REVIEW
  ACTIONED
  RESOLVED
  DISMISSED
}

/// `moderation_cases.case_type`.
/// Reports create cases; appeals are independently reviewed
/// (`specs/04-database-spec.md` §moderation_cases notes).
enum ModerationCaseType {
  REPORT
  APPEAL
}

/// `moderation_cases.status` — `specs/06-verification-state-machine.md` §Moderation.
enum ModerationCaseStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  APPEALED
  FINALIZED
}

/// `moderation_cases.severity`.
enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// `notifications.channel` — `specs/04-database-spec.md`.
enum NotificationChannel {
  IN_APP
  WECHAT_SUBSCRIBE
  SMS
  EMAIL
}

/// `notifications.event_type` — `specs/04-database-spec.md`.
enum NotificationEventType {
  ORDER_CREATED
  PAYMENT_SUCCEEDED
  BOOKING_CONFIRMED
  CANCELLED
  REFUND_SUCCEEDED
  REVIEW_REMINDER
  VERIFICATION_RESULT
  MODERATION_RESULT
}

/// `notifications.status` — `specs/04-database-spec.md`.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

/// `consents.consent_type` — `specs/10-privacy-and-minors.md` §Consent model.
enum ConsentType {
  TERMS
  PRIVACY
  SENSITIVE_DATA
  MINOR_GUARDIAN
  MARKETING
  IM_POLICY
}

/// `child_profiles.data_processing_consent_status`.
/// Guardian consent is required before processing child data
/// (`specs/10-privacy-and-minors.md`).
enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

/// `audit_logs.actor_type`.
/// `SYSTEM` covers automated actors (`actor_user_id` is then NULL).
enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

/// `platform_rules.status`. Versioned, published rules
/// (`specs/10-privacy-and-minors.md` §Platform rules).
enum PlatformRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// `users`. `wechat_openid_hash` / `unionid_hash` / `phone_encrypted` store
/// hashes or ciphertext only — never raw identifiers (AGENTS.md §9).
model User {
  id               String     @id @default(uuid()) @db.Uuid
  status           UserStatus @default(ACTIVE)
  wechatOpenidHash String?    @unique @map("wechat_openid_hash")
  unionidHash      String?    @map("unionid_hash")
  displayName      String     @map("display_name")
  avatarUrl        String?    @map("avatar_url")
  phoneEncrypted   String?    @map("phone_encrypted")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  roles                     UserRole[]
  sessions                  Session[]
  parentProfile             ParentProfile?
  childProfiles             ChildProfile[]       @relation("ChildGuardian")
  providerProfiles          ProviderProfile[]
  orders                    Order[]
  reviewsGiven              Review[]             @relation("ReviewReviewer")
  reviewsReceived           Review[]             @relation("ReviewReviewee")
  conversationMemberships   ConversationMember[]
  sentMessageRefs           MessageReference[]   @relation("MessageSender")
  filedReports              Report[]             @relation("ReportReporter")
  moderatedReports          Report[]             @relation("ReportModerator")
  createdBlocks             Block[]              @relation("BlockBlocker")
  receivedBlocks            Block[]              @relation("BlockBlocked")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  consents                  Consent[]
  reviewedVerificationCases VerificationCase[]   @relation("VerificationReviewer")
  assignedModerationCases   ModerationCase[]     @relation("ModerationAssignee")
  appealReviewedCases       ModerationCase[]     @relation("ModerationAppealReviewer")

  @@index([status])
  @@map("users")
}

/// `user_roles`. A user may hold multiple roles (`specs/01-business-rules.md`).
/// There is no separate `roles` table in the V1 schema: the role domain is the
/// enum, and `specs/04-database-spec.md` defines no columns for a `roles` table.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// `sessions`. Only token hashes are persisted; raw tokens are never stored
/// (`specs/04-database-spec.md` §sessions notes).
model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  accessTokenJti       String?   @map("access_token_jti")
  deviceLabel          String?   @map("device_label")
  ipHash               String?   @map("ip_hash")
  userAgentHash        String?   @map("user_agent_hash")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason")
  rotatedFromSessionId String?   @map("rotated_from_session_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Refresh tokens rotate: the new session points at the previous one, which is
  // revoked or marked rotated (`specs/04-database-spec.md` §sessions notes).
  rotatedFrom Session?  @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rotatedTo   Session[] @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// `consents` — `specs/10-privacy-and-minors.md` §Consent model.
model Consent {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  consentType   ConsentType @map("consent_type")
  policyVersion String      @map("policy_version")
  granted       Boolean
  grantedAt     DateTime    @map("granted_at")
  revokedAt     DateTime?   @map("revoked_at")
  evidenceRef   String?     @map("evidence_ref")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Profile
// ---------------------------------------------------------------------------

/// `parent_profiles`.
model ParentProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  cityCode    String?  @map("city_code")
  timezone    String   @default("Asia/Shanghai")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

/// `child_profiles`. Private by design: no phone, no address, no identity
/// document (`specs/10-privacy-and-minors.md` §Child profile rules).
model ChildProfile {
  id                          String        @id @default(uuid()) @db.Uuid
  guardianUserId              String        @map("guardian_user_id") @db.Uuid
  nickname                    String
  birthYear                   Int?          @map("birth_year")
  gradeCode                   String?       @map("grade_code")
  schoolName                  String?       @map("school_name")
  learningGoals               String?       @map("learning_goals")
  dataProcessingConsentStatus ConsentStatus @default(PENDING) @map("data_processing_consent_status")
  createdAt                   DateTime      @default(now()) @map("created_at")
  updatedAt                   DateTime      @updatedAt @map("updated_at")
  deletedAt                   DateTime?     @map("deleted_at")

  guardian User    @relation("ChildGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([guardianUserId, deletedAt])
  @@map("child_profiles")
}

/// `provider_profiles`.
/// `searchable` is the discovery gate: it is only ever set by the server after
/// approval (`specs/01-business-rules.md` §Provider approval).
model ProviderProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  providerType        ProviderType     @default(TUTORING) @map("provider_type")
  publicName          String           @map("public_name")
  headline            String?
  bio                 String?
  avatarVisibility    AvatarVisibility @default(PRIVATE) @map("avatar_visibility")
  avatarAssetId       String?          @map("avatar_asset_id")
  cityCode            String?          @map("city_code")
  serviceMode         DeliveryMode     @default(ONLINE) @map("service_mode")
  approvalStatus      ApprovalStatus   @default(DRAFT) @map("approval_status")
  searchable          Boolean          @default(false)
  ratingAvg           Decimal?         @map("rating_avg") @db.Decimal(3, 2)
  ratingCount         Int              @default(0) @map("rating_count")
  completedOrderCount Int              @default(0) @map("completed_order_count")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities      ProviderCapability[]
  verificationCases VerificationCase[]
  services          Service[]
  availability      AvailabilitySlot[]
  orders            Order[]

  @@index([userId])
  @@index([searchable, approvalStatus, cityCode])
  @@map("provider_profiles")
}

/// `provider_capabilities`. One person may hold several capabilities; each has
/// its own status/verification/compliance state (`specs/01-business-rules.md`).
model ProviderCapability {
  id                String            @id @default(uuid()) @db.Uuid
  providerId        String            @map("provider_id") @db.Uuid
  capabilityType    String            @map("capability_type")
  status            ApprovalStatus    @default(DRAFT)
  verificationLevel VerificationLevel @default(NONE) @map("verification_level")
  complianceStatus  ComplianceStatus  @default(NOT_REQUIRED) @map("compliance_status")
  /// Scope of a `RESTRICTED` compliance decision (T007).
  /// `specs/06-verification-state-machine.md`: "Restriction can be
  /// category/time/location specific through `restriction_json`".
  restrictionJson   Json?             @map("restriction_json")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, capabilityType, status])
  @@map("provider_capabilities")
}

// ---------------------------------------------------------------------------
// Verification
// ---------------------------------------------------------------------------

/// `verification_cases`. Verification is a separate aggregate from provider
/// approval (`AGENTS.md` §7).
model VerificationCase {
  id               String             @id @default(uuid()) @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  verificationType VerificationType   @map("verification_type")
  status           VerificationStatus @default(DRAFT)
  submittedAt      DateTime?          @map("submitted_at")
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewerId       String?            @map("reviewer_id") @db.Uuid
  decisionReason   String?            @map("decision_reason")
  evidenceRef      String?            @map("evidence_ref")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  provider  ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer  User?                  @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  documents VerificationDocument[]

  @@index([providerId, verificationType])
  @@index([status, createdAt])
  @@map("verification_cases")
}

/// `verification_documents`. Private bucket only; the DB stores a storage key,
/// a file hash and encrypted metadata — never the document itself
/// (`specs/10-privacy-and-minors.md` §Verification documents).
model VerificationDocument {
  id                String                   @id @default(uuid()) @db.Uuid
  caseId            String                   @map("case_id") @db.Uuid
  documentType      VerificationDocumentType @map("document_type")
  storageKey        String                   @map("storage_key")
  fileHash          String                   @map("file_hash")
  encryptedMetadata String?                  @map("encrypted_metadata")
  expiresAt         DateTime?                @map("expires_at")
  createdAt         DateTime                 @default(now()) @map("created_at")

  verificationCase VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("verification_documents")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// `taxonomy_terms`. Terms are archived (`active=false`), never hard deleted
/// (`specs/05-api-spec.md` §Taxonomy notes).
model TaxonomyTerm {
  id       String       @id @default(uuid()) @db.Uuid
  type     TaxonomyType
  code     String
  name     String
  parentId String?      @map("parent_id") @db.Uuid
  active   Boolean      @default(true)

  parent       TaxonomyTerm?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children     TaxonomyTerm[] @relation("TaxonomyTree")
  serviceTerms ServiceTerm[]

  @@unique([type, code])
  @@index([type, active])
  @@map("taxonomy_terms")
}

/// `service_terms` — join table between services and taxonomy terms.
model ServiceTerm {
  serviceId String @map("service_id") @db.Uuid
  termId    String @map("term_id") @db.Uuid

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  term    TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([serviceId, termId])
  @@index([termId, serviceId])
  @@map("service_terms")
}

/// `services`. Price is server authoritative (`specs/01-business-rules.md` §Service).
model Service {
  id                   String        @id @default(uuid()) @db.Uuid
  providerId           String        @map("provider_id") @db.Uuid
  domain               ServiceDomain @default(TUTORING)
  title                String
  description          String?
  durationMinutes      Int           @map("duration_minutes")
  priceMinor           Int           @map("price_minor")
  currency             String        @default("CNY") @db.VarChar(3)
  deliveryMode         DeliveryMode  @default(ONLINE) @map("delivery_mode")
  status               ServiceStatus @default(DRAFT)
  cancellationPolicyId String?       @map("cancellation_policy_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  terms    ServiceTerm[]
  orders   Order[]

  @@index([providerId, status])
  @@index([domain, status])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Tutoring / availability
// ---------------------------------------------------------------------------

/// `availability_slots`.
model AvailabilitySlot {
  id             String             @id @default(uuid()) @db.Uuid
  providerId     String             @map("provider_id") @db.Uuid
  startAt        DateTime           @map("start_at")
  endAt          DateTime           @map("end_at")
  recurrenceRule String?            @map("recurrence_rule")
  status         AvailabilityStatus @default(OPEN)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startAt])
  @@index([providerId, status, startAt])
  @@map("availability_slots")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

/// `orders`. Source of truth for order status; status changes only through
/// explicit transitions (`specs/06-verification-state-machine.md` §Order).
model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  orderNo             String        @unique @map("order_no")
  buyerUserId         String        @map("buyer_user_id") @db.Uuid
  providerId          String        @map("provider_id") @db.Uuid
  serviceId           String        @map("service_id") @db.Uuid
  childId             String?       @map("child_id") @db.Uuid
  domain              ServiceDomain @default(TUTORING)
  status              OrderStatus   @default(PENDING_PAYMENT)
  amountMinor         Int           @map("amount_minor")
  platformFeeMinor    Int           @default(0) @map("platform_fee_minor")
  providerAmountMinor Int           @default(0) @map("provider_amount_minor")
  currency            String        @default("CNY") @db.VarChar(3)
  scheduledStart      DateTime?     @map("scheduled_start")
  scheduledEnd        DateTime?     @map("scheduled_end")
  priceSnapshot       Json          @map("price_snapshot")
  policySnapshot      Json          @map("policy_snapshot")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  buyer         User            @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  child         ChildProfile?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  payments      Payment[]
  refunds       Refund[]
  reviews       Review[]
  conversations Conversation[]

  @@index([buyerUserId, createdAt(sort: Desc)])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, scheduledStart])
  @@index([childId])
  @@map("orders")
}

/// `payments`. Nothing here is trusted from the client: the server confirms
/// success through notification/query (`specs/08-payment-and-settlement.md`).
model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider @default(MOCK)
  providerTransactionId String?         @unique @map("provider_transaction_id")
  status                PaymentStatus   @default(INITIATED)
  amountMinor           Int             @map("amount_minor")
  prepayReference       String?         @map("prepay_reference")
  paidAt                DateTime?       @map("paid_at")
  rawCallbackRef        String?         @map("raw_callback_ref")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// `refunds`. Refund amounts are always calculated server-side (AGENTS.md §7).
model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amountMinor Int          @map("amount_minor")
  reason      String?
  status      RefundStatus @default(REQUESTED)
  providerRef String?      @map("provider_ref")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Trust
// ---------------------------------------------------------------------------

/// `reviews`. One review per eligible order/direction
/// (`specs/04-database-spec.md` §reviews).
model Review {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  reviewerUserId String       @map("reviewer_user_id") @db.Uuid
  revieweeUserId String       @map("reviewee_user_id") @db.Uuid
  rating         Int
  content        String?
  status         ReviewStatus @default(PUBLISHED)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User  @relation("ReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewee User  @relation("ReviewReviewee", fields: [revieweeUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, reviewerUserId, revieweeUserId])
  @@index([revieweeUserId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// `reports`. Intake record only; the workflow state lives in `moderation_cases`.
model Report {
  id             String               @id @default(uuid()) @db.Uuid
  reporterUserId String               @map("reporter_user_id") @db.Uuid
  targetType     ModerationTargetType @map("target_type")
  targetId       String               @map("target_id") @db.Uuid
  reasonCode     ReportReasonCode     @map("reason_code")
  description    String?
  status         ReportStatus         @default(PENDING)
  moderatorId    String?              @map("moderator_id") @db.Uuid
  resolution     String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  reporter       User            @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  moderator      User?           @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  moderationCase ModerationCase?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// `moderation_cases`. Owns the moderation state machine
/// (`specs/04-database-spec.md` §moderation_cases notes).
model ModerationCase {
  id                  String               @id @default(uuid()) @db.Uuid
  sourceReportId      String?              @unique @map("source_report_id") @db.Uuid
  caseType            ModerationCaseType   @default(REPORT) @map("case_type")
  targetType          ModerationTargetType @map("target_type")
  targetId            String               @map("target_id") @db.Uuid
  status              ModerationCaseStatus @default(OPEN)
  severity            ModerationSeverity?
  assignedModeratorId String?              @map("assigned_moderator_id") @db.Uuid
  decision            String?
  decisionReason      String?              @map("decision_reason")
  actionTaken         String?              @map("action_taken")
  appealReason        String?              @map("appeal_reason")
  appealReviewerId    String?              @map("appeal_reviewer_id") @db.Uuid
  beforeJson          Json?                @map("before_json")
  afterJson           Json?                @map("after_json")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  sourceReport      Report? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  assignedModerator User?   @relation("ModerationAssignee", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  appealReviewer    User?   @relation("ModerationAppealReviewer", fields: [appealReviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([assignedModeratorId, status])
  @@map("moderation_cases")
}

/// `blocks`. A blocked user cannot start a new conversation (`specs/09-im-spec.md`).
model Block {
  blockerUserId String   @map("blocker_user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Communication
// ---------------------------------------------------------------------------

/// `conversations`. Transport is provided by the IM adapter; this table only
/// holds platform-side references.
model Conversation {
  id                     String             @id @default(uuid()) @db.Uuid
  domain                 ServiceDomain      @default(TUTORING)
  orderId                String?            @map("order_id") @db.Uuid
  status                 ConversationStatus @default(OPEN)
  providerConversationId String?            @map("provider_conversation_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  order       Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messageRefs MessageReference[]

  @@index([orderId])
  @@map("conversations")
}

model ConversationMember {
  conversationId String                 @map("conversation_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           ConversationMemberRole

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// `message_refs`. Message content is not persisted by default
/// (`specs/04-database-spec.md` §message_refs notes).
model MessageReference {
  id                String                  @id @default(uuid()) @db.Uuid
  conversationId    String                  @map("conversation_id") @db.Uuid
  externalMessageId String                  @map("external_message_id")
  senderUserId      String                  @map("sender_user_id") @db.Uuid
  messageType       MessageType             @default(TEXT) @map("message_type")
  moderationStatus  MessageModerationStatus @default(PENDING) @map("moderation_status")
  createdAt         DateTime                @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([moderationStatus, createdAt])
  @@map("message_refs")
}

/// `notifications`. Template code + params only: never persist rendered bodies
/// containing personal data (`specs/04-database-spec.md` §notifications notes).
model Notification {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  channel             NotificationChannel   @default(IN_APP)
  eventType           NotificationEventType @map("event_type")
  title               String
  bodyTemplateCode    String                @map("body_template_code")
  bodyParamsJson      Json?                 @map("body_params_json")
  relatedResourceType String?               @map("related_resource_type")
  relatedResourceId   String?               @map("related_resource_id")
  dedupeKey           String?               @unique @map("dedupe_key")
  status              NotificationStatus    @default(PENDING)
  readAt              DateTime?             @map("read_at")
  sentAt              DateTime?             @map("sent_at")
  failureReason       String?               @map("failure_reason")
  retryCount          Int                   @default(0) @map("retry_count")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

/// `audit_logs`. Every privileged mutation is audited (AGENTS.md §7).
model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  action       String
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")
  beforeJson   Json?          @map("before_json")
  afterJson    Json?          @map("after_json")
  ipHash       String?        @map("ip_hash")
  requestId    String         @map("request_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// `platform_rules`. Versioned public platform rules
/// (`specs/10-privacy-and-minors.md` §Platform rules).
model PlatformRule {
  id          String             @id @default(uuid()) @db.Uuid
  ruleType    String             @map("rule_type")
  version     String
  status      PlatformRuleStatus @default(DRAFT)
  contentRef  String             @map("content_ref")
  effectiveAt DateTime?          @map("effective_at")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([ruleType, version])
  @@index([ruleType, status])
  @@map("platform_rules")
}

/// `feature_flags`. V1 tutoring is enabled by default; career is flagged
/// (`AGENTS.md` §7, `specs/03-architecture-spec.md` §Feature flags).
model FeatureFlag {
  key        String   @id
  enabled    Boolean  @default(false)
  configJson Json     @default("{}") @map("config_json")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
